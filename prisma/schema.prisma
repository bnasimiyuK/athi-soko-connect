generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"] 
}

enum Role {
  ADMIN
  USER
  RESIDENT
  VENDOR
  SECURITY
  SUPER_ADMIN

  @@schema("public")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  phone     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Property Details
  phase       String?
  courtName   String?
  houseNumber String?

  // Payments
  ahewaOptIn Boolean @default(false)
  aheStatus  String  @default("PENDING")
  mpesaCode  String?

  @@schema("public")
}

model PendingRegistration {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  password    String
  phase       String
  courtName   String
  houseNumber String
  ahewaOptIn  Boolean
  createdAt   DateTime @default(now())

  @@schema("public")
}